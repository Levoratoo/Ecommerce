{
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs" },
    { "source": "/webhooks/:path*", "destination": "/api/index.mjs" },
    { "source": "/health", "destination": "/api/index.mjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
