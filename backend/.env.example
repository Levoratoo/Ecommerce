# Banco de dados (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=string_aleatoria_minimo_32_chars

# URL deste backend (em dev: localhost, em prod: URL do Railway)
AUTH_URL=http://localhost:3000

# URL do frontend (em dev: localhost do Vite, em prod: URL do Vercel)
FRONTEND_URL=http://localhost:5173

# Ambiente
NODE_ENV=development
PORT=3000
